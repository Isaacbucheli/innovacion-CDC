# Fuente ÚNICA del host de la API en producción (R2).
# Consumido por:
#   - src/lib/api.ts        -> Vite lo inyecta en el bundle vía import.meta.env.VITE_API_BASE_URL
#   - scripts/gen-swa-config.mjs -> genera el connect-src del CSP en staticwebapp.config.json
# El CSP es un archivo estático (el navegador necesita el host literal), por eso se genera
# desde staticwebapp.config.template.json en el build en vez de hardcodearlo por duplicado.
VITE_API_BASE_URL=https://app-optimizacion-costos-api-dotnet.azurewebsites.net
